# Copie para .env.local (ignorado pelo Git). NUNCA versione segredos.
# F1 não exige nenhuma variável: a aplicação sobe com os valores padrão.

# Ambiente exibido na faixa de aviso: local | test | preview | production
NEXT_PUBLIC_APP_ENV=local

# --- Reservado para fases futuras (NÃO preencher na F1) ---
# Supabase local (valores impressos por `npm run db:start`; requer Docker):
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=   # segredo — somente servidor, nunca NEXT_PUBLIC_
#
# Pagamentos e videochamada: nenhum fornecedor escolhido; sem variáveis.
